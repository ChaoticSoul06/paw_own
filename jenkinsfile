pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'feature-pages',
                    url: 'https://github.com/ChaoticSoul06/paw_own.git'
            }
        }

        stage('Test') {
            steps {
                echo 'Checking required pages'
                bat '''
                if not exist index.html exit 1
                if not exist about.html exit 1
                if not exist contact.html exit 1
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying to XAMPP htdocs'
                bat '''
                robocopy . E:\\xampp\\htdocs\\paw_own /E /XD .git
                if %ERRORLEVEL% LEQ 7 exit /B 0
                exit /B %ERRORLEVEL%
                '''
            }
        }
    }
}
